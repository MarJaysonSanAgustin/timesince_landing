{
  "name": "timesince-homepage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "assets:sync": "node --experimental-strip-types scripts/gen-image-manifest.ts",
    "content:new": "node --experimental-strip-types scripts/new-content.ts",
    "content:check": "node --experimental-strip-types scripts/validate-content.ts",
    "check:contrast": "node --experimental-strip-types scripts/check-contrast.ts",
    "prebuild": "npm run assets:sync",
    "verify": "npm run content:check && npm run check:contrast && next typegen && tsc --noEmit && eslint . && next build",
    "clean": "next clean"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "^16.4.2",
    "next-mdx-remote": "^6.0.0",
    "postcss": "^8.5.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
